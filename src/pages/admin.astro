---
import Layout from '../layouts/Layout.astro';
import Brand from '../components/Brand.astro';
---
<Layout title="The guest list — Project Heaven" sharePreview={false}>
<header class="site-header"><Brand/><span class="header-note">BEYOND THE GATES / HOST ACCESS</span><a class="header-link" href="/">VIEW INVITATION ↗</a></header>
<main class="admin-main"><div class="admin-heading"><div><span class="eyebrow">THE INNER CIRCLE</span><h1>The guest list.</h1><p>Send a summoning. See who's coming.</p></div><button id="logout" class="button" hidden>Sign out ↗</button></div>
<form id="login" class="login-card"><h2>For the hosts.</h2><p class="subtle">Enter your host password to open the guest list.</p><label for="password">Host password</label><input id="password" name="password" type="password" autocomplete="current-password" required/><button class="button primary">Enter the inner circle <span>↗</span></button><p id="login-message" class="form-message" role="status"></p></form>
<section id="dashboard" hidden><div class="stats"><div class="stat"><strong id="total-count">0</strong><span>INVITED SOULS</span></div><div class="stat"><strong id="yes-count">0</strong><span>COMING</span></div><div class="stat"><strong id="pending-count">0</strong><span>AWAITING A SIGN</span></div><div class="stat"><strong id="no-count">0</strong><span>CAN'T MAKE IT</span></div></div><button id="add-guest" class="button primary">＋ Create an invitation</button><div class="admin-tools"><input id="search" aria-label="Search guests" placeholder="Find a soul…" type="search"/><select id="filter" aria-label="Filter RSVP status"><option value="all">All responses</option><option value="yes">Coming</option><option value="pending">Awaiting a sign</option><option value="no">Can't make it</option></select><button id="refresh" class="button">Refresh ↻</button></div><p id="admin-message" role="status" class="form-message"></p><div id="guest-list" class="guest-list"></div></section>
</main>
<dialog id="create-dialog"><form id="create-form"><h2>Summon a soul.</h2><p class="subtle">Each guest gets a personal link and QR code.</p><label for="name">Guest name</label><input id="name" name="name" maxlength="100" required autocomplete="off" placeholder="Their name"/><p id="create-message" role="status" class="form-message"></p><div class="dialog-actions"><button type="button" class="button" data-close>Cancel</button><button class="button primary">Create invite ↗</button></div></form></dialog>
<dialog id="qr-dialog"><h2 id="qr-title">Your invitation</h2><img id="qr-image" alt="Personal invitation QR code"/><a id="qr-url" target="_blank" rel="noreferrer"></a><div class="dialog-actions"><button class="button" data-close>Close</button><a id="qr-download" class="button primary" download="project-heaven-invitation.png">Save QR ↓</a></div></dialog>
<script src="../scripts/admin.ts"></script>
</Layout>
