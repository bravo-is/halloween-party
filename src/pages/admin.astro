---
import Layout from '../layouts/Layout.astro';
import Brand from '../components/Brand.astro';
---
<Layout title="The guest list — Project Heaven" sharePreview={false}>
<header class="site-header"><Brand/><span class="header-note">BEYOND THE GATES / HOST ACCESS</span><a class="header-link" href="/">VIEW INVITATION <span aria-hidden="true">&#8599;&#65038;</span></a></header>
<main class="admin-main"><div class="admin-heading"><div><h1>The guest list.</h1><p>Send a summoning. See who's coming.</p></div><button id="logout" class="button" hidden>Sign out <span aria-hidden="true">&#8599;&#65038;</span></button></div>
<form id="login" class="login-card" method="post"><h2>For the hosts.</h2><p class="subtle">Enter your host password to open the guest list.</p><label for="password">Host password</label><input id="password" name="password" type="password" autocomplete="current-password" required/><button class="button primary">Enter the inner circle <span><span aria-hidden="true">&#8599;&#65038;</span></span></button><p id="login-message" class="form-message" role="status"></p></form>
<section id="dashboard" hidden><div class="stats"><div class="stat"><strong id="total-count">0</strong><span>INVITED (WITH +1s)</span></div><div class="stat"><strong id="yes-count">0</strong><span>COMING (WITH +1s)</span></div><div class="stat"><strong id="pending-count">0</strong><span>AWAITING A SIGN</span></div><div class="stat"><strong id="no-count">0</strong><span>CAN'T MAKE IT</span></div></div><form id="announcement-form" class="announcement-editor"><h2>Announcements board</h2><label for="announcement">Public party updates</label><p class="subtle">Edit this board anytime. Leave it blank to clear it. Everyone can read it, so keep private details out.</p><textarea id="announcement" maxlength="3000" rows="5"></textarea><button class="button primary">Save announcement</button><p id="announcement-message" class="form-message" role="status"></p></form><button id="add-guest" class="button primary">＋ Create an invitation</button><div class="admin-tools"><input id="search" aria-label="Search guests" placeholder="Find a soul…" type="search"/><select id="filter" aria-label="Filter RSVP status"><option value="all">All responses</option><option value="yes">Coming</option><option value="pending">Awaiting a sign</option><option value="no">Can't make it</option></select><button id="refresh" class="button">Refresh ↻︎</button></div><p id="admin-message" role="status" class="form-message"></p><div id="guest-list" class="guest-list"></div></section>
</main>
<dialog id="create-dialog"><form id="create-form"><h2>Summon a soul.</h2><p class="subtle">Each guest gets a personal link and QR code.</p><label for="name">Guest name</label><input id="name" name="name" maxlength="100" required autocomplete="off" placeholder="Their name"/><label class="check-label"><input id="create-plus-one" type="checkbox"/> Allow a +1</label><p id="create-message" role="status" class="form-message"></p><div class="dialog-actions"><button type="button" class="button" data-close>Cancel</button><button class="button primary">Create invite <span aria-hidden="true">&#8599;&#65038;</span></button></div></form></dialog>
<dialog id="qr-dialog"><h2 id="qr-title">Your invitation</h2><div id="qr-image-slot"></div><a id="qr-url" target="_blank" rel="noreferrer"></a><div class="dialog-actions"><button class="button" data-close>Close</button><a id="qr-download" class="button primary" download="project-heaven-invitation.png">Save QR <span aria-hidden="true">&#8595;&#65038;</span></a></div></dialog>
<script src="../scripts/admin.ts"></script>
</Layout>

