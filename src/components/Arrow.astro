---
const { direction = 'up-right' } = Astro.props;
const paths = {
  'up-right': 'M5 19 19 5M5 5h14v14',
  'down-right': 'm5 5 14 14M5 19h14V5',
  down: 'M12 4v16m-7-7 7 7 7-7',
};
---
<svg class="arrow-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={paths[direction as keyof typeof paths] ?? paths['up-right']} /></svg>
