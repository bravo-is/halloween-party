---
const spheres = [[8,28,36,0,14],[18,47,90,-6,17],[28,15,26,-3,13],[34,37,42,-8,16],[12,73,24,-2,12],[3,59,58,-4,19],[69,19,56,-5,15],[80,41,102,-10,19],[91,23,29,-6,14],[96,63,66,-1,17],[70,65,32,-9,13],[87,78,22,-4,16],[40,9,16,-5,12],[60,31,21,-2,16],[22,87,18,-7,18]];
---
<div class="orb-scene" aria-hidden="true">
  <div class="heaven-haze"></div>
  {spheres.map(([x,y,size,delay,duration]) => <div class="suspended-light" style={`--x:${x}%;--y:${y}%;--size:${size}px;--delay:${delay}s;--duration:${duration}s`}><span class="suspension"></span><span class="sphere"></span></div>)}
</div>
<div class="hero-sigil"><img src="/project-heaven-sigil.png" alt="Project Heaven sigil" width="295" height="935" fetchpriority="high" /></div>
<script>
  // Browser-managed timelines keep moving without scroll events or a JS frame loop.
  // Leave CSS animations as the fallback until each replacement is created.
  const motion = matchMedia('(prefers-reduced-motion: reduce)');
  const animations: Animation[] = [];
  const lights = document.querySelectorAll<HTMLElement>('.suspended-light');
  const cue = document.querySelector<HTMLElement>('.scroll-cue-orb');
  const reset = () => {
    animations.splice(0).forEach(animation => animation.cancel());
    lights.forEach(light => light.style.removeProperty('animation'));
    cue?.style.removeProperty('animation');
  };
  const setup = () => {
    reset();
    if (motion.matches || !Element.prototype.animate) return;
    lights.forEach(light => {
      const style = getComputedStyle(light);
      const duration = (parseFloat(style.getPropertyValue('--duration')) || 15) * 1000;
      const delay = (parseFloat(style.getPropertyValue('--delay')) || 0) * 1000;
      const animation = light.animate([
        { transform: 'translate3d(-5px, 12px, 0)' },
        { transform: 'translate3d(6px, -34px, 0)' },
      ], { duration, delay, iterations: Infinity, direction: 'alternate', easing: 'ease-in-out' });
      light.style.animation = 'none';
      animations.push(animation);
    });
    if (cue) {
      const animation = cue.animate([
        { transform: 'translate3d(0, 0, 0)', opacity: 0, offset: 0 },
        { opacity: 1, offset: .15 },
        { opacity: 1, offset: .8 },
        { transform: 'translate3d(0, 96px, 0)', opacity: 0, offset: 1 },
      ], { duration: 2800, iterations: Infinity, easing: 'ease-in-out' });
      cue.style.animation = 'none';
      animations.push(animation);
    }
  };
  motion.addEventListener('change', setup);
  // Restore timelines when Safari returns this document from its page cache.
  window.addEventListener('pageshow', setup);
  setup();
</script>
